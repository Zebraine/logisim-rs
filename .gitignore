# Default deny: minimal build, root documents, and runnable circuit examples.
*

# Workspace, toolchain, license, and root project documents.
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/rustfmt.toml
!/clippy.toml
!/LICENSE
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md

# Git and build-check configuration; do not allow arbitrary dotfiles.
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.cargo/
!/.cargo/config.toml
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/workflows/release.yml
!/.github/scripts/
!/.github/scripts/package.py

# Package manifests, build scripts, and Rust sources only.
!/apps/
!/apps/**/
!/apps/**/Cargo.toml
!/apps/**/build.rs
!/apps/**/src/**/*.rs
!/crates/
!/crates/**/
!/crates/**/Cargo.toml
!/crates/**/build.rs
!/crates/**/src/**/*.rs

# Language catalogs are compile-time inputs, embedded in the application.
!/crates/logisim-ui/locales/en.json
!/crates/logisim-ui/locales/zh-CN.json

# Published CPU examples and their shared runtime plugin only.
!/examples/
!/examples/course/
!/examples/course/*.circ
!/examples/course/course.wasm

# Local design and observation material, including each directory's README.
/docs/
/experiments/
/specs/
/fixtures/
/resources/

# Keep generated files and caches excluded even inside source trees.
**/target/
**/cache/
**/.cache/
**/__pycache__/
.DS_Store
Thumbs.db
*.swp

# Source tests for the drawing cache, not generated cache contents.
!/crates/logisim-ui/src/drawing/cache/
!/crates/logisim-ui/src/drawing/cache/tests.rs
