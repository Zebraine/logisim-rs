      <a name="xor" val="odd" />
    </tool>
    <tool name="XNOR Gate">
      <a name="labelfont" val="Dialog plain 12" />
      <a name="xor" val="odd" />
    </tool>
    <tool name="Odd Parity">
      <a name="facing" val="south" />
      <a name="inputs" val="3" />
      <a name="labelfont" val="Dialog plain 12" />
    </tool>
    <tool name="Controlled Buffer">
      <a name="facing" val="north" />
      <a name="labelfont" val="Dialog plain 12" />
    </tool>
  </lib>
  <lib desc="#Plexers" name="2">
