+
+// Finite arithmetic job at the production fuel cap. This checks an observable
+// pause boundary, separate from either engine rejecting an infinite job.
+#[test]
+fn finite_calibration_job_at_production_fuel_budget() {
+    for iterations in [100_000, 1_000_000, 2_000_000, 3_000_000, 4_000_000] {
+        let work = format!(
+            "(local $n i32) i32.const {iterations} local.set $n \
+             (loop $work local.get $n i32.const 1 i32.sub local.tee $n br_if $work)"
+        );
+        let result = Plugin::load(&wasm(&Response::Manifest(manifest()), 1, &work));
+        let expected = if cfg!(feature = "compare-wasmtime") {
+            iterations < 2_000_000
+        } else {
+            iterations < 4_000_000
+        };
+        println!(
+            "iterations={iterations} accepted={} expected={expected}",
+            result.is_ok()
+        );
+        assert_eq!(result.is_ok(), expected);
+        if let Err(message) = result {
+            assert!(message.contains("fuel"), "{message}");
+        }
+    }
+}
